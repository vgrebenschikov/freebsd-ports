#!/bin/sh
#
# PROVIDE:
# REQUIRE: LOGIN
# KEYWORD: shutdown
#
# telemt_enable: Set to YES to enable the telemt service.
#       Default: NO
#
# telemt_config: Configuration file
#	Default: /usr/local/etc/telemt/config.toml
#
# telemt_user: The user account used to run the telemt daemon.
#       This is optional, however do not specifically set this to an
#       empty string as this will cause the daemon to run as root.
#       Default:  "nobody"
#
# telemt_group: The group account used to own files created by this script.
#       Default:  "nobody"

. /etc/rc.subr
name=telemt
rcvar=${name}_enable

pidfile="/var/run/${name}.pid"
logfile="/var/log/${name}.log"

load_rc_config ${name}
: ${telemt_enable:="NO"}
: ${telemt_config:="/usr/local/etc/telemt/config.toml"}
: ${telemt_user:="nobody"}
: ${telemt_group:="nobody"}

command="/usr/sbin/daemon"
procname="/usr/local/bin/telemt"

start_precmd=${name}_prestart
telemt_prestart() {
  [ -f "${logfile}" ] \
	|| install -m 664 -o "${telemt_user}" -g "${telemt_group}" -- /dev/null "${logfile}" \
	|| return 1

  install -m 664 -o "${telemt_user}" -g "${telemt_group}" -- /dev/null "${pidfile}" \
	|| return 1

  rc_flags="-c -f -o ${logfile} -p ${pidfile} ${procname} ${telemt_config}"
}

run_rc_command "$1"
