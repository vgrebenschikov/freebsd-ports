+/*
+ * Scratch storage belongs to the caller: never modify the authenticated
+ * message or its shared name/RDATA storage. Length-preserving replacement
+ * also preserves DNS label boundaries and the configured zone suffix.
+ */
+typedef struct {
+	dns_fixedname_t owner;
+	unsigned char ptr[DNS_NAME_MAXWIRE];
+} update_fixname_t;
+
+static void
+fix_hostname_wire(unsigned char *wire, unsigned int length, bool wildcard) {
+	unsigned int pos = 0;
+
+	while (pos < length) {
+		unsigned int n = wire[pos++];
+		INSIST(n <= 63 && n <= length - pos);
+		if (wildcard && pos == 1 && n == 1 && wire[pos] == '*') {
+			pos += n;
+			continue;
+		}
+		for (unsigned int i = 0; i < n; i++) {
+			unsigned char c = wire[pos + i];
+			bool alnum = (c >= 'a' && c <= 'z') ||
+				     (c >= 'A' && c <= 'Z') ||
+				     (c >= '0' && c <= '9');
+			if (!alnum && (c != '-' || i == 0 || i == n - 1)) {
+				wire[pos + i] = (i == 0 || i == n - 1) ? 'x' : '-';
+			}
+		}
+		pos += n;
+	}
+}
+
+static void
+fix_update_rr(dns_zone_t *zone, dns_name_t **name, dns_rdata_t *rdata,
+	      update_fixname_t *scratch) {
+	dns_name_t *origin = dns_zone_getorigin(zone);
+	dns_name_t *owner;
+
+	if ((dns_zone_getoptions(zone) & DNS_ZONEOPT_UPDATEFIXNAMES) == 0 ||
+	    !dns_name_issubdomain(*name, origin))
+	{
+		return;
+	}
+	owner = dns_fixedname_initname(&scratch->owner);
+	dns_name_copy(*name, owner);
+	fix_hostname_wire(owner->ndata, owner->length - origin->length, true);
+	*name = owner;
+	if (rdata->type == dns_rdatatype_ptr && rdata->length != 0) {
+		INSIST(rdata->length <= sizeof(scratch->ptr));
+		memmove(scratch->ptr, rdata->data, rdata->length);
+		fix_hostname_wire(scratch->ptr, rdata->length, false);
+		rdata->data = scratch->ptr;
+	}
+}
